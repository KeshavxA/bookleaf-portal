# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=info

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bookleaf?schema=public

# --- Auth ---
# At least 32 random characters. Generate with: openssl rand -base64 48
# Optional in development (this placeholder is used). In production the server
# refuses to start if it is missing, shorter than 32 chars, or equal to this placeholder.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h

# --- AI (server-side only; never exposed to the frontend) ---
# Which provider serves classification and drafts: anthropic (default) or gemini.
LLM_PROVIDER=anthropic
# Only the SELECTED provider's key is used. If it is empty the server still starts (one warning)
# and runs in degraded mode: keyword triage, and the draft endpoint returns draft=null with an error.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Anthropic defaults to claude-haiku-5-5. For gemini this is REQUIRED (no default: Gemini model ids
# change often; check https://ai.google.dev/gemini-api/docs/models). Suggested (from that page on
# 2026-10-21, not yet run against the API): gemini-3.5-flash-lite
LLM_MODEL=
# Gemini classifier thinking: minimal (default) | low | medium | high | off (thinkingBudget 0, 2.5 models only)
GEMINI_CLASSIFIER_THINKING=minimal
# Per-attempt timeout. Empty = provider default (15000 anthropic, 30000 gemini); a value overrides both.
LLM_TIMEOUT_MS=
LLM_MAX_RETRIES=2
# Circuit breaker: open after N consecutive upstream failures, probe again after cooldown.
# An exhausted quota (e.g. Gemini free-tier daily limit) opens it immediately.
LLM_BREAKER_THRESHOLD=5
LLM_BREAKER_COOLDOWN_MS=30000
# Cost estimates for AiCall.estCost (USD per million tokens). Anthropic: leave empty for the
# built-in rate card. Gemini: 0 = free tier; set your paid rates if the project is billed.
ANTHROPIC_PRICE_INPUT_PER_MTOK=
ANTHROPIC_PRICE_OUTPUT_PER_MTOK=
GEMINI_PRICE_INPUT_PER_MTOK=0
GEMINI_PRICE_OUTPUT_PER_MTOK=0

# --- Rate limits (per window) ---
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_AI_MAX=20
RATE_LIMIT_AI_WINDOW_MS=60000

# --- Seed ---
# true: the deploy-time seed also creates ~8 pre-classified demo tickets (idempotent, no LLM calls).
# Locally you can run `npm run seed:demo` instead.
SEED_DEMO_TICKETS=false
