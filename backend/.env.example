# --- Server ---
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=info

# --- Database ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bookleaf?schema=public

# --- Auth ---
# At least 32 random characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h

# --- AI (server-side only; never exposed to the frontend) ---
# Leave empty to run with AI disabled: tickets fall back to keyword triage
# and the draft endpoint returns draft=null with an error.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_TIMEOUT_MS=15000
LLM_MAX_RETRIES=2
# Circuit breaker: open after N consecutive upstream failures, probe again after cooldown
LLM_BREAKER_THRESHOLD=5
LLM_BREAKER_COOLDOWN_MS=30000

# --- Rate limits (per window) ---
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_AI_MAX=20
RATE_LIMIT_AI_WINDOW_MS=60000

# --- Seed ---
# Creates a handful of demo tickets (from the KB sample queries) on an empty DB
SEED_DEMO_TICKETS=true
