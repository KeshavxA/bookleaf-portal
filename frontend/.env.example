# Serve all API calls (including SSE) from the in-browser MSW mock layer.
# Set to false to talk to the real backend.
VITE_USE_MOCKS=true

# Base URL of the API, including the /api/v1 prefix. Relative URLs go through the
# Vite dev proxy (DEV_PROXY_TARGET), which avoids CORS locally.
VITE_API_URL=/api/v1

# Dev server only: where /api is proxied when VITE_API_URL is relative.
DEV_PROXY_TARGET=http://localhost:4000

# Mock mode only: make every AI draft request fail, to exercise the manual-reply fallback.
VITE_MOCK_AI_DOWN=false
